# deploy/pod/env.pod.example — names only, every value empty. Committed. Never fill this file in
# and commit the result; real values go into RunPod's pod-creation env map / Secrets feature only.
#
# Everything NOT listed here (RUST_MIN_STACK, CLOUD_PROVIDER, GRAPH_WRITER_LEASE_MS,
# GRAPH_DATA_CACHE_BYTES, the AWS_ENDPOINT/AWS_BUCKET/AWS_REGION triple, the bolt/admin bind
# addresses, PORT, HOST, ...) is already baked into deploy/pod/Dockerfile as an image default and
# does not need to be set again at pod creation. Set these ONLY if a value must differ from the
# image default, or is a secret the image cannot bake in.

# --- required at every pod creation: MinIO's own root credentials. entrypoint.sh derives
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from these automatically -- do not set those two
# separately unless they must differ from the MinIO credentials. Put both behind RunPod Secrets
# ({{ RUNPOD_SECRET_<name> }}), not as plain pod env. ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- which ingested history the demo endpoints default to when a request omits history_id ---
ERRATA_DEMO_HISTORY=

# --- REQUIRED for the PUBLISHED behaviour. Without it /api/ask does not fail -- it silently
# degrades to the deterministic fold, which measures 8.3 overall against the 60.0 in eval/RESULTS.md.
# A judge hitting the deployed URL would then be reading a different system from the one the README
# describes, so the earlier "keep it off the pod" guidance is WITHDRAWN. Behind RunPod Secrets.
# The runaway-spend worry that guidance was avoiding is now handled by ERRATA_BUDGET_CAP below. ---
OPENROUTER_API_KEY=
# Hard cap on CUMULATIVE ledger spend in USD; the client refuses to call once the ledger is past it.
# Default 50 when unset. The API seeds its running total from the on-disk ledger at startup
# (apps/api/src/deps.ts) exactly as the ingest CLI does, so the cap no longer re-arms at zero every
# time the pod restarts -- which is what makes it safe to put the key on an always-on pod at all.
ERRATA_BUDGET_CAP=

# --- REQUIRED on the pod: the shared secret gating POST /api/correction, the one route that writes.
# The write is append-only, so a bad one cannot be undone -- and unset means the route is OPEN, which
# is right for a laptop and wrong for a public URL. Set it here AND, as the same value, in the Vercel
# project: that proxy injects the header server-side (apps/web/app/api/errata/[...path]/route.ts) so
# the browser app keeps working without ever seeing the secret. Behind RunPod Secrets. ---
ERRATA_WRITE_KEY=

# --- MUST STAY UNSET ON THE POD. ERRATA_DEBUG_OK=1 makes POST /api/ask honour `"debug": true`, which
# returns the verbatim evidence spans of the ranked claims plus a bounded scan of the history's
# claims, to any caller that asks. It belongs on a dev box and on whatever host replays
# eval/failure_review.py -- never here. Listed only so nobody adds it back by accident. ---
# ERRATA_DEBUG_OK=

# --- optional answer-path tuning; each has a working default in apps/api/src/deps.ts ---
ERRATA_TAU=
ERRATA_MATERIAL_MAX=

# --- optional metadata surfaced by GET /api/meta; harmless if left unset ---
GIT_SHA=
ERRATA_CORPUS_REVISION=
