# deploy/railway/env.railway.example — names only, every value empty. Committed. Never fill this
# file in and commit the result; real values go into the Railway service's Variables tab only
# (mark the ones flagged SECRET as sealed/secret variables there).
#
# Everything NOT listed here (RUST_MIN_STACK, CLOUD_PROVIDER, GRAPH_WRITER_LEASE_MS,
# GRAPH_DATA_CACHE_BYTES, the AWS_ENDPOINT/AWS_BUCKET/AWS_REGION triple, the bolt/admin bind
# addresses, ERRATA_LEXICON_DIR, HOST, ...) is already baked into deploy/railway/Dockerfile as an
# image default. Set those again ONLY to override.
#
# PORT is injected by Railway itself — do not set it by hand. The API binds it
# (apps/api/src/index.ts) and Railway health-checks that same port.

# --- REQUIRED. MinIO's root credentials. entrypoint.sh derives AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from these. They must MATCH the credentials the restored snapshot's MinIO
# data was written under — the snapshot carries .minio.sys with it. SECRET. ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- REQUIRED on Railway: the volume starts empty, so the graph arrives over the network on first
# boot. Both values are printed by scripts/package-snapshot.sh (and written to
# dist-snapshot/railway-snapshot-env.txt). Space-separated, POSITIONAL: the Nth checksum verifies
# the Nth URL. Not secrets — a public release URL and a list of hashes. ---
SNAPSHOT_URLS=
SNAPSHOT_SHA256S=

# --- which ingested history the demo endpoints default to when a request omits history_id ---
ERRATA_DEMO_HISTORY=

# --- REQUIRED for the PUBLISHED behaviour. Without it /api/ask does not fail -- it silently
# degrades to the deterministic fold, which measures 8.3 overall against the 60.0 in
# eval/RESULTS.md. SECRET. ---
OPENROUTER_API_KEY=
# Hard cap on CUMULATIVE ledger spend in USD; default 50 when unset. The API seeds its running
# total from the on-disk ledger at startup (apps/api/src/deps.ts), so the cap does not re-arm at
# zero on every restart. Set it alongside the key.
ERRATA_BUDGET_CAP=

# --- REQUIRED: the shared secret gating POST /api/correction, the one route that writes. The write
# is append-only, so a bad one cannot be undone -- and UNSET means the route is OPEN. Set it here
# AND, as the same value, in the Vercel project (its proxy injects the header server-side). SECRET. ---
ERRATA_WRITE_KEY=

# --- MUST STAY UNSET. ERRATA_DEBUG_OK=1 makes POST /api/ask honour `"debug": true`, returning the
# verbatim evidence spans of the ranked claims plus a bounded scan of the history's claims, to any
# caller that asks. Listed only so nobody adds it back by accident. ---
# ERRATA_DEBUG_OK=

# --- Railway-specific. Default is 0 seconds between SIGTERM and SIGKILL on teardown, which is
# shorter than the 58s deploy/railway/supervisord.conf waits for graph-node to flush and release
# its writer lease. Set it to 60. See deploy/README.md ("Stop behaviour"). ---
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=

# --- optional answer-path tuning; each has a working default in apps/api/src/deps.ts ---
ERRATA_TAU=
ERRATA_MATERIAL_MAX=

# --- optional metadata surfaced by GET /api/meta; harmless if left unset ---
GIT_SHA=
ERRATA_CORPUS_REVISION=
