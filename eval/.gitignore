# Standalone uv project artifacts.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Downloaded corpus + index cache live under data/ and are not committed;
# data/manifest.json is the exception (the re-runnability artifact).
data/*
!data/manifest.json

# Run outputs are gitignored EXCEPT the committed report directory.
out/*
!out/report/

# The failure taxonomy is an analysis deliverable, not a run output.
!out/failure-taxonomy.md

# The scored control set is the evidence behind the published FAR/FRR, and kappa.py joins the
# human labels against it — so it is committed, unlike the run outputs beside it.
!out/judge-controls-scored.jsonl
