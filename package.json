{
  "name": "errata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @errata/web dev",
    "dev:api": "pnpm --filter @errata/api dev",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && pnpm --filter @errata/web typecheck",
    "test": "vitest run",
    "audit": "pnpm audit --prod --audit-level high --ignore-registry-errors",
    "licenses": "node scripts/license-gate.mjs",
    "stack:up": "./scripts/stack-init.sh && docker compose --env-file .env --env-file .env.local up -d",
    "stack:down": "docker compose down",
    "stack:nuke": "docker compose down -v && rm -rf .data",
    "stack:logs": "docker compose logs -f --tail=100",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
